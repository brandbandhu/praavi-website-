{
  "routes": [
    {
      "src": "/public-pages/(.*)\\.html",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "/(services(?:/[a-z0-9-]+){0,2}|website-development|seo-services|social-media-marketing|portfolio|case-studies|clients|team|ai-solutions|industries/[a-z0-9-]+|pune/[a-z0-9-]+|career|blog|contact)/?",
      "dest": "/public-pages/$1.html",
      "check": true
    },
    {
      "src": "/blog/([a-z0-9]+(?:-[a-z0-9]+)*)\\.html",
      "status": 308,
      "headers": {
        "Location": "/blog/$1"
      }
    },
    {
      "src": "/blog/([a-z0-9]+(?:-[a-z0-9]+)*)/?",
      "dest": "/blog/$1.html",
      "check": true
    },
    {
      "src": "/about\\.html",
      "status": 308,
      "headers": {
        "Location": "/about"
      }
    },
    {
      "src": "/about/?",
      "dest": "/about.html"
    },
    {
      "src": "/(social_desk|internal/quote-tool|dm_quotation_maker-myadmin|finance-management-system|diwali-wishes|digital_marketing_team|my_praavi_consultant_pc_admin_yes|admin|internal-app\\.html)(/.*)?",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/diwali-wishes/?",
      "dest": "/diwali-wishes/index.html"
    },
    {
      "src": "/landing/?",
      "status": 308,
      "headers": {
        "Location": "/june-offer"
      }
    },
    {
      "src": "/june-offer/?",
      "dest": "/june-offer/index.html"
    },
    {
      "src": "/internal/quote-tool/myadmin/?",
      "dest": "/internal/quote-tool/myadmin/index.html"
    },
    {
      "src": "/dm_quotation_maker-myadmin/?",
      "dest": "/dm_quotation_maker-myadmin/index.html"
    },
    {
      "src": "/(social_desk|digital_marketing_team|my_praavi_consultant_pc_admin_yes|admin)(/.*)?",
      "dest": "/internal-app.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/finance-management-system/fms/praavi-internal/app(/.*)?",
      "dest": "/finance-management-system/fms/praavi-internal/app/index.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(internal/quote-tool|dm_quotation_maker-myadmin|finance-management-system|diwali-wishes)(/.*)?",
      "dest": "/internal-app.html"
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ],
  "proxy": {
    "entrypoint": "proxy.ts",
    "matcher": [
      "/",
      "/about/:path*",
      "/services/:path*",
      "/website-development/:path*",
      "/seo-services/:path*",
      "/social-media-marketing/:path*",
      "/ai-solutions/:path*",
      "/portfolio/:path*",
      "/case-studies/:path*",
      "/team/:path*",
      "/clients/:path*",
      "/career/:path*",
      "/contact/:path*",
      "/blog/:path*",
      "/industries/:path*",
      "/pune/:path*",
      "/june-offer/:path*"
    ]
  }
}
